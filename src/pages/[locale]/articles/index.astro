---
import { getCollection } from "astro:content";
import logo from "../../../../public/images/logo.svg";
import Search from "../../../components/Search";
import Layout from "../../../layouts/Layout.astro";
import { type Article, getArticleFilter, getArticlePath, type Phase, phases } from "../../../utils/articles";
import { getTranslations, type Locale, locales } from "../../../utils/i18n";

export async function getStaticPaths() {
  return (Object.keys(locales) as Locale[]).map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = getTranslations(locale);

const articles = (await getCollection("articles", getArticleFilter({ locale, published: true }))).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const pagefindPath = `${import.meta.env.BASE_URL}pagefind/pagefind.js`;
const articlesByPhase = phases
  .map((phase) => [phase, articles.filter((article) => article.data.phases.includes(phase))] as [Phase, Article[]])
  .filter(([, group]) => group.length > 0);
---

<Layout title={t("home.title")}>
  <main>
    <img src={logo.src} alt="Heimfibel" class="h-48 w-48 float-right m-5 hidden lg:inline" />
    <h1 class="text-4xl font-bold mt-3">
      {t("home.brand_prefix") && <span class="font-normal text-stiftung-200">{t("home.brand_prefix")}</span>}{
        t("home.brand")
      }{t("home.brand_suffix") && <span class="font-normal text-stiftung-200">{t("home.brand_suffix")}</span>}
    </h1>
    <p class="italic">
      {t("home.tool_by")} <a class="underline" href={t("home.foundation_url")}>{t("home.foundation")}</a>
    </p>
    <h2 class="text-2xl font-bold mt-10 mb-5">{t("home.subtitle")}</h2>
    <p class="mb-4 leading-relaxed">{t("home.intro")}</p>
    <div class="mb-5 mt-10">
      <Search path={pagefindPath} placeholder={t("search.placeholder")} client:load />
    </div>

    {
      articlesByPhase.map(([phase, articleGroup]) => (
        <section>
          <h3 class="text-3xl font-bold mt-20 mb-10 text-center">{t(`phase.${phase}`)}</h3>
          <ul class="article-list bg-stiftung-700 shadow-xl rounded-handdrawn border-4 border-amber-200 text-stiftung-50 place-content-around p-8 flex flex-wrap">
            {articleGroup.map((article) => (
              <li>
                <a class="m-4 underline text-xl" href={getArticlePath(article)}>
                  {article.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Layout>

<style>
  ul.article-list {
    a {
      transition: opacity 100ms linear, transform 100ms linear;
      display: block;
    }

    &:has(a:hover) {
      a {
        opacity: 0.3;
      }

      a:hover {
        opacity: 1;
        transform: scale(1.3);
      }
    }

    & > li {
      &:nth-child(3n) a {
        transform: rotate(-3deg);
      }

      &:nth-child(3n + 1) a {
        transform: rotate(2deg);
      }

      &:nth-child(3n + 2) a {
        transform: rotate(4deg);
      }

      &:nth-child(4n) a {
        transform: scale(110%);
      }

      &:nth-child(4n + 2) a {
        margin: 1.5rem;
      }
    }
  }
</style>
