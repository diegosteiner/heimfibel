---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Layout from "../../../layouts/Layout.astro";
import {
  getArticleAlternates,
  getArticleFilter,
  getArticleLocale,
  getArticlePath,
  getArticleSlug,
} from "../../../utils/articles";

export const getStaticPaths = (async () => {
  const allArticles = await getCollection("articles", getArticleFilter({ published: true }));
  const seen = new Set<string>();

  return allArticles.map((article) => {
    const locale = getArticleLocale(article);
    const slug = getArticleSlug(article);
    const path = getArticlePath(article);

    if (article.data.locale !== locale) {
      throw new Error(`${article.id}: frontmatter locale "${article.data.locale}" does not match folder "${locale}"`);
    }
    if (seen.has(path)) throw new Error(`${article.id}: duplicate URL ${path}`);
    seen.add(path);

    const linkedArticles = allArticles.filter(
      (other) => getArticleLocale(other) === locale && article.data.links?.includes(other.data.nr),
    );

    return {
      params: { locale, slug },
      props: { article, linkedArticles, alternates: getArticleAlternates(article, allArticles) },
    };
  });
}) satisfies GetStaticPaths;

const { article, linkedArticles, alternates } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { Content } = await render(article);
const { title, tags } = article.data;
---

<Layout title={title} alternates={alternates}>
  <article
    class="bg-amber-200 p-5 lg:p-10 rounded-xl text-stiftung-900 shadow-xl"
  >
    <h1 class="text-4xl font-bold mb-5 text-stiftung-900">{title}</h1>
    <div class="hidden">
      {tags?.map((tag: string) => <h2>{tag}</h2>)}
    </div>
    <div
      class="prose-p:mb-4 prose-p:leading-relaxed
             prose-h2:text-2xl prose-h2:font-bold prose-h2:mb-4
             prose-h3:text-xl prose-h3:font-bold prose-h3:mb-4
             prose-h4:text-lg prose-h4:font-bold prose-h4:mb-4
             prose-ul:list-disc prose-ul:pl-6 prose-ul:mb-4
             prose-li:mb-1 prose-a:underline my-8"
    >
      <Content />
    </div>
    <ul>
      {
        linkedArticles.map((linkedArticle) => (
          <li class="text-base inline-block m-1 bg-rust-200 p-1 rounded-handdrawn border-2 border-rust-600">
            <a href={getArticlePath(linkedArticle)}>{linkedArticle.data.title}</a>
          </li>
        ))
      }
    </ul>
  </article>
</Layout>
